<div class="rounded-lg border bg-card text-card-foreground shadow-sm">
  <div class="flex flex-col md:flex-row md:min-h-[24rem]">
    <div class="border-b md:border-b-0 md:border-r w-full md:w-48 shrink-0 p-3">
      <h4 class="mb-3 px-2 text-sm font-medium text-muted-foreground">General</h4>
      <nav class="flex flex-row gap-1 md:flex-col" role="tablist" aria-orientation="vertical">
        <%= link_to "Details", edit_space_path(@space), data: { turbo_frame: "_top" }, class: "inline-flex items-center rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-accent/50 hover:text-accent-foreground transition-colors" %>
        <span class="inline-flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium bg-accent text-accent-foreground">Roles</span>
      </nav>
    </div>
    <div class="flex-1 p-4 md:p-6">
      <%= render "details", role: role %>
    </div>
  </div>
</div>
