<% content_for :page_pretitle do %>
  Space / Subscriptions
<% end %>
<% content_for :page_title do %>
  <%= @space.name %>
<% end %>
<div class="flex flex-col gap-6">
  <% if @active_subscription.present? %>
    <div class="relative rounded-lg border bg-card text-card-foreground shadow-sm overflow-hidden">
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center rounded-md bg-green-500/90 px-2 py-0.5 text-xs font-medium text-white">Active</span>
      </div>
      <div class="h-1 w-full bg-green-500" aria-hidden="true"></div>
      <div class="p-6">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="text-sm text-muted-foreground">Plan name</p>
            <p class="mt-1 text-lg font-semibold"><%= @active_subscription.plan&.name %></p>
          </div>
          <div>
            <p class="text-sm text-muted-foreground">Start date</p>
            <p class="mt-1 text-lg font-semibold"><%= @active_subscription.start_date || '-' %></p>
          </div>
          <div>
            <p class="text-sm text-muted-foreground">End date</p>
            <p class="mt-1 text-lg font-semibold"><%= @active_subscription.end_date || '-' %></p>
          </div>
          <div>
            <p class="text-sm text-muted-foreground">Seats</p>
            <p class="mt-1 text-lg font-semibold"><%= @active_subscription.seats || '-' %></p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <%= render 'plans' %>
</div>
