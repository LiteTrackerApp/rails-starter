<div class="grid gap-6 lg:grid-cols-2">
  <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="p-6">
      <h3 class="text-lg font-semibold leading-none tracking-tight mb-4">Billing Information</h3>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Email address</label>
          <input type="email" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="Email" />
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">First Name</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="Company" value="Chet" />
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Last Name</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="Last Name" value="Faker" />
        </div>
        <div class="sm:col-span-2">
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Address line 1</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="Home Address" value="Melbourne, Australia" />
        </div>
        <div class="sm:col-span-2">
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Address line 2</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="Home Address" value="Melbourne, Australia" />
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">City</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="City" value="Melbourne" />
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Postal Code</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="ZIP Code" />
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Country</label>
          <select class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
            <option value="">Germany</option>
          </select>
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">State</label>
          <input type="text" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" placeholder="State" />
        </div>
      </div>
    </div>
  </div>
  <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="p-6">
      <h3 class="text-lg font-semibold leading-none tracking-tight mb-4">Payment</h3>
      <div class="space-y-4">
        <div>
          <label class="text-sm font-medium text-muted-foreground block">Plan name</label>
          <p class="mt-0.5 text-sm font-medium"><%= @plan.name %></p>
        </div>
        <div>
          <label class="text-sm font-medium text-muted-foreground block">Amount</label>
          <p class="mt-0.5 text-sm font-medium"><%= @plan.price %> <%= @plan.currency %></p>
        </div>
        <div>
          <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 mb-2 block">Payment method</label>
          <div class="space-y-2">
            <label class="flex items-center gap-3 rounded-md border border-input p-3 cursor-pointer hover:bg-accent/50 transition-colors">
              <input type="radio" name="form-payment" value="visa" class="size-4 rounded-full border-primary text-primary focus:ring-primary" />
              <span class="text-sm">Visa ending in <strong>7998</strong></span>
            </label>
            <label class="flex items-center gap-3 rounded-md border border-input p-3 cursor-pointer hover:bg-accent/50 transition-colors">
              <input type="radio" name="form-payment" value="mastercard" class="size-4 rounded-full border-primary text-primary focus:ring-primary" checked />
              <span class="text-sm">Mastercard ending in <strong>2807</strong></span>
            </label>
            <label class="flex items-center gap-3 rounded-md border border-input p-3 cursor-pointer hover:bg-accent/50 transition-colors">
              <input type="radio" name="form-payment" value="paypal" class="size-4 rounded-full border-primary text-primary focus:ring-primary" />
              <span class="text-sm">PayPal</span>
            </label>
          </div>
        </div>
      </div>
    </div>
    <%= form_for @subscription, url: space_subscriptions_path(@space, @subscription), method: :post do |form| %>
      <%= form.hidden_field :space_id, value: @space.id %>
      <%= form.hidden_field :plan_id, value: @plan.id %>
      <%= form.hidden_field :start_date, value: Date.today %>
      <div class="flex justify-end border-t p-4">
        <button type="submit" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Submit</button>
      </div>
    <% end %>
  </div>
</div>
