<div class="rounded-lg border bg-card text-card-foreground shadow-sm">
  <div class="flex flex-col md:flex-row md:min-h-[20rem]">
    <div class="border-b md:border-b-0 md:border-r w-full md:w-48 shrink-0 p-3">
      <h4 class="mb-3 px-2 text-sm font-medium text-muted-foreground">General</h4>
      <nav class="flex flex-row gap-1 md:flex-col">
        <span class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium bg-accent text-accent-foreground">Details</span>
      </nav>
    </div>
    <div class="flex-1 p-4 md:p-6">
      <h2 class="text-lg font-semibold leading-none tracking-tight mb-4">New user</h2>
      <%= form_with url: space_users_path(@space), method: :post, class: "flex flex-col gap-6" do |form| %>
        <div class="form-field">
          <%= form.label :email, class: "form-label" %>
          <%= form.text_field :email, class: "input-shadcn", placeholder: "Enter email", "aria-describedby": "emailHelp" %>
        </div>
        <div class="form-field">
          <%= form.label :role, class: "form-label" %>
          <%= form.select :role_id, @space_roles.map { |role| [role.name, role.id] }, {}, { class: "input-shadcn flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50", "aria-describedby": "roleHelp" } %>
        </div>
        <div class="flex items-center gap-2 pt-2">
          <%= form.submit "Save", class: "btn-primary" %>
          <%= link_to "Cancel", space_users_path(@space), data: { turbo_frame: "_top" }, class: "text-muted-foreground text-sm underline underline-offset-4 hover:text-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
