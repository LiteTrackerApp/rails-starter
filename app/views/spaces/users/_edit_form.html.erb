<div class="rounded-lg border bg-card text-card-foreground shadow-sm">
  <div class="flex flex-col md:flex-row md:min-h-[20rem]">
    <div class="border-b md:border-b-0 md:border-r w-full md:w-48 shrink-0 p-3">
      <h4 class="mb-3 px-2 text-sm font-medium text-muted-foreground">General</h4>
      <nav class="flex flex-row gap-1 md:flex-col">
        <span class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium bg-accent text-accent-foreground">Role</span>
      </nav>
    </div>
    <div class="flex-1 p-4 md:p-6">
      <h2 class="text-lg font-semibold leading-none tracking-tight mb-4">User role</h2>
      <%= form_with model: @user_role, url: space_user_path(@space, @user), method: :patch, class: "flex flex-col gap-6" do |form| %>
        <% if @user_role.errors.any? %>
          <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            <h3 class="font-medium"><%= pluralize(@user_role.errors.count, "error") %> prohibited this user role from being saved:</h3>
            <ul class="mt-2 list-disc list-inside">
              <% @user_role.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="form-field">
          <%= form.label :role, class: "form-label" %>
          <%= form.select :role_id, @space_roles.map { |role| [role.name, role.id] }, {}, { class: "input-shadcn flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50", "aria-describedby": "roleHelp" } %>
        </div>
        <div class="flex items-center gap-2 pt-2">
          <%= form.submit "Save", class: "btn-primary" %>
          <%= link_to "Cancel", space_users_path(@space), data: { turbo_frame: "_top" }, class: "text-muted-foreground text-sm underline underline-offset-4 hover:text-primary" %>
        </div>
      <% end %>
      <div class="mt-8 pt-6 border-t">
        <h2 class="text-lg font-semibold leading-none tracking-tight mb-4">Restricted</h2>
        <%= button_to "Remove user from space", space_user_path(@space, @user), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "inline-flex items-center justify-center rounded-md text-sm font-medium bg-destructive text-destructive-foreground hover:bg-destructive/90 h-9 px-4" %>
      </div>
    </div>
  </div>
</div>
