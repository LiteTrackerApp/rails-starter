<h2 class="text-lg font-semibold leading-none tracking-tight mb-4">Details</h2>
<%= form_with(model: user, class: "flex flex-col gap-6") do |form| %>
  <% if user.errors.any? %>
    <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <h3 class="font-medium"><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="form-field">
    <%= form.label :first_name, class: "form-label" %>
    <%= form.text_field :first_name, class: "input-shadcn", placeholder: "Enter first name", "aria-describedby": "firstNameHelp" %>
  </div>
  <div class="form-field">
    <%= form.label :last_name, class: "form-label" %>
    <%= form.text_field :last_name, class: "input-shadcn", placeholder: "Enter last name", "aria-describedby": "lastNameHelp" %>
  </div>
  <div class="form-field">
    <%= form.label :email, class: "form-label" %>
    <%= form.text_field :email, class: "input-shadcn", placeholder: "Enter email", disabled: true, "aria-describedby": "emailHelp" %>
  </div>
  <div class="form-field">
    <%= form.label :phone, class: "form-label" %>
    <%= form.text_field :phone, class: "input-shadcn", placeholder: "Enter phone", "aria-describedby": "phoneHelp" %>
  </div>
  <div class="form-field">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, User.statuses.keys.map { |key| [key.humanize, key] }, {}, { class: "input-shadcn flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50", "aria-describedby": "statusHelp" } %>
  </div>
  <div class="form-field">
    <%= form.label :avatar, class: "form-label" %>
    <%= form.file_field :avatar, class: "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm file:border-0 file:bg-transparent file:text-sm file:font-medium", "aria-describedby": "avatarHelp" %>
  </div>
  <div class="pt-2">
    <%= form.submit "Save", class: "btn-primary" %>
  </div>
<% end %>
