<div class="grid gap-6 md:grid-cols-2">
  <div class="flex flex-col gap-6">
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="p-4">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex size-12 items-center justify-center rounded-full bg-muted text-lg font-medium text-muted-foreground">
            <%= abbrev_name(user.name) %>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="font-semibold leading-none tracking-tight truncate">
              <%= user_name(user.name) %>
            </h4>
            <p class="text-muted-foreground text-sm mt-0.5"><%= user.status %></p>
            <p class="text-muted-foreground text-xs mt-1">
              <span class="inline-flex h-2 w-2 rounded-full bg-green-500"></span> Online
            </p>
          </div>
          <div class="flex items-center gap-2">
            <a href="#" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4">
              Subscribe
            </a>
            <div class="relative inline-block">
              <details class="group/details">
                <summary class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md border border-input bg-background text-muted-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground [&::-webkit-details-marker]:hidden">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                  <span class="sr-only">Open menu</span>
                </summary>
                <div class="absolute right-0 top-full z-50 mt-1 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md">
                  <a href="#" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">Import</a>
                  <a href="#" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">Export</a>
                  <a href="#" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">Download</a>
                  <a href="#" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">Another action</a>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
        <div class="flex items-center gap-4 p-4">
          <div class="flex size-10 items-center justify-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2" /><path d="M12 3v3m0 12v3" /></svg>
          </div>
          <div>
            <p class="font-medium">132 Sales</p>
            <p class="text-muted-foreground text-sm">12 waiting payments</p>
          </div>
        </div>
      </div>
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
        <div class="flex items-center gap-4 p-4">
          <div class="flex size-10 items-center justify-center rounded-md bg-green-500/10 text-green-600 dark:text-green-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="2" /><circle cx="17" cy="19" r="2" /><path d="M17 17h-11v-14h-2" /><path d="M6 5l14 1l-1 7h-13" /></svg>
          </div>
          <div>
            <p class="font-medium">78 Orders</p>
            <p class="text-muted-foreground text-sm">32 shipped</p>
          </div>
        </div>
      </div>
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
        <div class="flex items-center gap-4 p-4">
          <div class="flex size-10 items-center justify-center rounded-md bg-red-500/10 text-red-600 dark:text-red-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
          </div>
          <div>
            <p class="font-medium">1352 Members</p>
            <p class="text-muted-foreground text-sm">163 registered today</p>
          </div>
        </div>
      </div>
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
        <div class="flex items-center gap-4 p-4">
          <div class="flex size-10 items-center justify-center rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-13a3 3 0 0 1 3 -3h10a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-9l-4 4" /><line x1="8" y1="9" x2="16" y2="9" /><line x1="8" y1="13" x2="14" y2="13" /></svg>
          </div>
          <div>
            <p class="font-medium">132 Comments</p>
            <p class="text-muted-foreground text-sm">16 waitings</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b px-4 py-3">
      <h3 class="font-semibold leading-none tracking-tight">Basic info</h3>
      <%= link_to edit_user_path(user), class: "inline-flex items-center justify-center gap-1 rounded-md text-sm font-medium text-primary hover:underline underline-offset-4" do %>
        Edit details
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7h-3a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-3" /><path d="M9 15h3l8.5 -8.5a1.5 1.5 0 0 0 -3 -3l-8.5 8.5v3" /><line x1="16" y1="5" x2="19" y2="8" /></svg>
      <% end %>
    </div>
    <div class="p-4 space-y-3">
      <div class="flex items-start gap-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M16 12v1.5a2.5 2.5 0 0 0 5 0v-1.5a9 9 0 1 0 -5.5 8.28"/></svg>
        <span class="text-muted-foreground">Email:</span> <strong><%= user.email %></strong>
      </div>
      <div class="flex items-start gap-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/></svg>
        <span class="text-muted-foreground">Phone:</span> <strong><%= user.phone %></strong>
      </div>
      <div class="flex items-start gap-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"/></svg>
        <span class="text-muted-foreground">Job role:</span> <strong>Death Eater</strong>
      </div>
      <div class="flex items-start gap-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="11" r="3"/><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"/></svg>
        <span class="text-muted-foreground">Location:</span> <strong>Slovenia</strong>
      </div>
      <div class="flex items-start gap-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="5" width="16" height="16" rx="2"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="4" y1="11" x2="20" y2="11"/></svg>
        <span class="text-muted-foreground">Joining date:</span> <strong>13/01/1985</strong>
      </div>
      <div class="flex items-start gap-3 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-muted-foreground shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
        <span class="text-muted-foreground">Time zone:</span> <strong>Europe/Ljubljana</strong>
      </div>
    </div>
  </div>
</div>
