<div class="flex flex-col gap-6">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-6" }, data: { turbo: false }) do |f| %>
    <div class="text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm bg-card">
      <div class="@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 text-center">
        <div class="leading-none font-semibold text-xl">Edit account</div>
        <div class="text-muted-foreground text-sm">Update your password</div>
      </div>
      <div class="px-6">
        <div class="group/field-group flex w-full flex-col gap-7">
          <%= render "devise/shared/error_messages_shadcn", resource: resource %>
          <div class="form-field group/field">
            <label for="user_email" class="form-label">Email</label>
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <span class="text-muted-foreground text-xs">Currently waiting confirmation for: <%= resource.unconfirmed_email %></span>
            <% end %>
            <%= f.email_field :email, class: "input-shadcn", placeholder: "m@example.com", disabled: true %>
          </div>
          <div class="form-field group/field">
            <label for="user_current_password" class="form-label">Current password</label>
            <%= f.password_field :current_password, class: "input-shadcn", placeholder: "Current password", autofocus: true, autocomplete: "current-password" %>
          </div>
          <div class="form-field group/field">
            <label for="user_password" class="form-label">New password</label>
            <% if @minimum_password_length %>
              <span class="text-muted-foreground text-xs">(<%= @minimum_password_length %> characters minimum)</span>
            <% end %>
            <%= f.password_field :password, class: "input-shadcn", placeholder: "New password", autocomplete: "new-password" %>
          </div>
          <div class="form-field group/field">
            <label for="user_password_confirmation" class="form-label">Confirm new password</label>
            <%= f.password_field :password_confirmation, class: "input-shadcn", placeholder: "Confirm new password", autocomplete: "new-password" %>
          </div>
          <div class="form-field group/field">
            <%= f.submit "Update", class: "btn-primary" %>
            <p class="text-muted-foreground text-center text-sm">
              <%= link_to "Back", :back, class: "link-muted" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
