<div class="flex flex-col gap-6">
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "flex flex-col gap-6" }, data: { turbo: false }) do |f| %>
    <div class="text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm bg-card">
      <%= f.hidden_field :reset_password_token %>
      <div class="@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 text-center">
        <div class="leading-none font-semibold text-xl">Change your password</div>
        <div class="text-muted-foreground text-sm">Enter your new password below</div>
      </div>
      <div class="px-6">
        <div class="group/field-group flex w-full flex-col gap-7">
          <%= render "devise/shared/error_messages_shadcn", resource: resource %>
          <div class="form-field group/field">
            <label for="user_password" class="form-label">New password</label>
            <% if @minimum_password_length %>
              <span class="text-muted-foreground text-xs">(<%= @minimum_password_length %> characters minimum)</span>
            <% end %>
            <%= f.password_field :password, class: "input-shadcn", placeholder: "New password", autofocus: true, autocomplete: "new-password" %>
          </div>
          <div class="form-field group/field">
            <label for="user_password_confirmation" class="form-label">Confirm new password</label>
            <%= f.password_field :password_confirmation, class: "input-shadcn", placeholder: "Confirm new password", autocomplete: "new-password" %>
          </div>
          <div class="form-field group/field">
            <%= f.submit "Change my password", class: "btn-primary" %>
            <p class="text-muted-foreground text-center text-sm">
              <%= link_to "Back to sign in", new_session_path(resource_name), class: "link-muted" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
