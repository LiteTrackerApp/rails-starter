<div class="flex flex-col gap-6">
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-6" }, data: { turbo: false }) do |f| %>
    <div class="text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm bg-card">
      <div class="@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 text-center">
        <div class="leading-none font-semibold text-xl">Forgot password</div>
        <div class="text-muted-foreground text-sm">Enter your email and we'll send you reset instructions</div>
      </div>
      <div class="px-6">
        <div class="group/field-group flex w-full flex-col gap-7">
          <%= render "devise/shared/error_messages_shadcn", resource: resource %>
          <div class="form-field group/field">
            <label for="user_email" class="form-label">Email</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-shadcn", placeholder: "m@example.com" %>
          </div>
          <div class="form-field group/field">
            <%= f.submit "Send reset instructions", class: "btn-primary" %>
            <p class="text-muted-foreground text-center text-sm">
              <%= link_to "Back to sign in", new_session_path(resource_name), class: "link-muted" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
