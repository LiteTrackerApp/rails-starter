#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If starting the web server (rails server, puma, or thrust) then create or migrate database
case " $* " in
  *" rails "*" server "*|*" puma "*|*" thrust "*)
    ./bin/rails db:prepare
    ;;
esac

exec "${@}"
